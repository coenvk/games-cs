<?xml version="1.0" encoding="utf-8"?>
<!--
  Where packages come from: the Jentl engine from .jentl-packages (fill it with build/jentl.sh), everything else from
  nuget.org. Clearing first keeps machine-wide sources and mappings out of this repository's builds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="jentl" value=".jentl-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="jentl">
      <package pattern="Jentl.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
