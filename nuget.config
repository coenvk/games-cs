<?xml version="1.0" encoding="utf-8"?>
<!--
  Where packages come from: the Jentl engine from .jentl-packages (fill it with build/jentl.sh), the poker bot SDK for
  the starter kit in bots/csharp from .poker-packages (fill it with build/pokersdk.sh), everything else from nuget.org.
  Clearing first keeps machine-wide sources and mappings out of this repository's builds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="jentl" value=".jentl-packages" />
    <add key="poker" value=".poker-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="jentl">
      <package pattern="Jentl.*" />
    </packageSource>
    <packageSource key="poker">
      <package pattern="Poker.Bots" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
