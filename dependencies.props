<Project>
  <PropertyGroup>
    <!-- The engine: github.com/coenvk/jentl-cs. build/jentl.sh packs this version. -->
    <JentlVersion>0.4.4</JentlVersion>
    <!-- Game -->
    <MonoGameVersion>3.8.4.1</MonoGameVersion>
    <FontStashSharpVersion>1.6.2</FontStashSharpVersion>
    <!-- Web (KNI, a MonoGame fork with a Blazor WebAssembly platform) -->
    <StbImageSharpVersion>2.30.16</StbImageSharpVersion>
    <KniVersion>4.3.9001</KniVersion>
    <BlazorVersion>10.0.2</BlazorVersion>
    <!-- Game server (ASP.NET Core) -->
    <AspNetCoreVersion>10.0.2</AspNetCoreVersion>
    <!-- Testing -->
    <MicrosoftNetTestSdkVersion>17.14.1</MicrosoftNetTestSdkVersion>
    <XUnitVersion>2.9.3</XUnitVersion>
    <XUnitRunnerVersion>3.1.4</XUnitRunnerVersion>
    <FluentAssertionsVersion>6.12.0</FluentAssertionsVersion>
  </PropertyGroup>
</Project>
