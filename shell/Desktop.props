<Project>

  <!--
    Turns an app folder into a desktop game (MonoGame). The app's Desktop project sets AppName (the executable)
    and imports this; the shell's code and assets and the app's Game/ and Assets/ folders come in by themselves.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>$(AppName)</AssemblyName>
    <RootNamespace>Games</RootNamespace>
    <Version>1.0.0</Version>
    <RollForward>Major</RollForward>
    <TieredPGO>true</TieredPGO>
    <ShellDir>$(MSBuildThisFileDirectory)</ShellDir>
    <AppDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../'))</AppDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(ShellDir)Shell/**/*.cs;$(ShellDir)Desktop/**/*.cs" LinkBase="Shell" />
    <Compile Include="$(AppDir)Game/**/*.cs" LinkBase="Game" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jentl.Core" Version="$(JentlVersion)" />
    <PackageReference Include="Jentl.Net" Version="$(JentlVersion)" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="$(FontStashSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ShellDir)Assets/**/*.*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="$(AppDir)Assets/**/*.*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
