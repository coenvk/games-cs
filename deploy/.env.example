# Copy to deploy/.env and set DOMAIN. deploy/.env is not committed.

# The domain whose DNS A (and AAAA) record points at this host. Caddy gets its certificate for it.
DOMAIN=poker.example.org

# Poker league settings; the defaults are shown.
#POKER_HANDS=1000
#POKER_TIME_LIMIT_MS=1000
#POKER_ALLOWANCE_MS=500
#POKER_CONCURRENT=8
#POKER_BOTS_PER_OWNER=5
#POKER_REGISTRATIONS_PER_DAY=10
