<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RollForward>Major</RollForward>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="$(FontStashSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sokoban.Model\Sokoban.Model.csproj" />
    <ProjectReference Include="..\Jentl.Core\Jentl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*.png;Assets\**\*.ttf;Assets\**\*.txt;Assets\**\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\levels\*.xsb" LinkBase="Levels" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
