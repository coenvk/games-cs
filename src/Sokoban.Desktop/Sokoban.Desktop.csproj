<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Sokoban</AssemblyName>
    <Version>1.0.0</Version>
    <RollForward>Major</RollForward>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="$(FontStashSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sokoban.Model\Sokoban.Model.csproj" />
    <ProjectReference Include="..\Jentl.Core\Jentl.Core.csproj" />
    <ProjectReference Include="..\Sokoban.Solver\Sokoban.Solver.csproj" />
    <ProjectReference Include="..\Klondike\Klondike.csproj" />
    <ProjectReference Include="..\FreeCell\FreeCell.csproj" />
    <ProjectReference Include="..\Pyramid\Pyramid.csproj" />
    <ProjectReference Include="..\Spider\Spider.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**\*.png;Assets\**\*.ttf;Assets\**\*.txt;Assets\**\*.wav" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\levels\*.xsb" LinkBase="Levels" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
