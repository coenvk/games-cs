<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    The game in a browser: the desktop app's sources (minus its Program.cs) compiled against KNI,
    hosted in a Blazor WebAssembly page. Assets and levels are served as static files.
  -->
  <PropertyGroup>
    <KniPlatform>BlazorGL</KniPlatform>
    <DefineConstants>$(DefineConstants);BLAZORGL</DefineConstants>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!-- Mirrored copies of the linked game files (see MirrorGameFiles); the links themselves are the assets. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot/Assets/**;wwwroot/Levels/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Sokoban.Desktop\**\*.cs" Exclude="..\Sokoban.Desktop\Program.cs;..\Sokoban.Desktop\bin\**;..\Sokoban.Desktop\obj\**" LinkBase="Game" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Sokoban.Desktop\Assets\**\*.png;..\Sokoban.Desktop\Assets\**\*.ttf;..\Sokoban.Desktop\Assets\**\*.wav;..\Sokoban.Desktop\Assets\**\*.json;..\Sokoban.Desktop\Assets\**\*.tmx;..\Sokoban.Desktop\Assets\**\*.tsx" Link="wwwroot\Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\levels\*.xsb" Link="wwwroot\Levels\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The list of shipped game files, embedded so the page can download them all before the game starts. -->
  <ItemGroup>
    <EmbeddedResource Include="$(IntermediateOutputPath)gamefiles.txt" LogicalName="gamefiles.txt" />
  </ItemGroup>

  <!--
    The development server serves static files from wwwroot on disk, so linked files must physically
    exist there too. Publishing copies them anyway; this keeps "dotnet run" working.
  -->
  <Target Name="MirrorGameFiles" BeforeTargets="PrepareForBuild">
    <Copy SourceFiles="@(Content)" DestinationFiles="@(Content->'$(MSBuildProjectDirectory)/%(Link)')" Condition="'%(Content.Link)' != ''" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="WriteGameFileList" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <!-- Raw link paths (wwwroot/...); the page normalises separators when it reads the list. -->
      <_GameFile Include="@(Content->'%(Link)')" Condition="'%(Content.Link)' != ''" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)gamefiles.txt" Lines="@(_GameFile)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Jentl.Core.Kni\Jentl.Core.Kni.csproj" />
    <ProjectReference Include="..\Sokoban.Model\Sokoban.Model.csproj" />
    <ProjectReference Include="..\Sokoban.Solver\Sokoban.Solver.csproj" />
    <ProjectReference Include="..\Klondike\Klondike.csproj" />
    <ProjectReference Include="..\FreeCell\FreeCell.csproj" />
    <ProjectReference Include="..\Pyramid\Pyramid.csproj" />
    <ProjectReference Include="..\Spider\Spider.csproj" />
    <ProjectReference Include="..\TriPeaks\TriPeaks.csproj" />
    <ProjectReference Include="..\FortyThieves\FortyThieves.csproj" />
    <ProjectReference Include="..\Yukon\Yukon.csproj" />
    <ProjectReference Include="..\Easthaven\Easthaven.csproj" />
    <ProjectReference Include="..\Golf\Golf.csproj" />
    <ProjectReference Include="..\Mossbrook\Mossbrook.csproj" />
    <ProjectReference Include="..\CodeLock\CodeLock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Kni.Platform.Blazor.GL" Version="$(KniVersion)" />
    <PackageReference Include="FontStashSharp.Kni" Version="$(FontStashSharpVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(BlazorVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(BlazorVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
